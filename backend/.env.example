# ==============================================================================
# Database Configuration (TASK-001)
# ==============================================================================
# Connection string for PostgreSQL / Supabase
# Direct connection (Session mode):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Connection pooler (Transaction mode):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ==============================================================================
# Supabase Authentication & JWT Configuration (TASK-004 / HD-12)
# ==============================================================================
# Base URL of Supabase project
# SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# JWKS public key endpoint (defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL="https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"
# Expected JWT issuer (defaults to ${SUPABASE_URL}/auth/v1)
# JWT_ISSUER="https://[YOUR-PROJECT-REF].supabase.co/auth/v1"
# Expected JWT audience (standard: authenticated)
# JWT_AUDIENCE="authenticated"

# ==============================================================================
# AI / LLM Configuration (TASK-009 / HD-03 / HRD-01)
# ==============================================================================
# AI Provider: "gemini" or "mock"
AI_PROVIDER="gemini"
# Google Gemini API Key (keep secret, do not commit .env)
LLM_API_KEY="your-google-gemini-api-key-here"
# Model identifier
LLM_MODEL="gemini-3.8-flash"
# Request timeout in seconds
LLM_TIMEOUT=10.0
